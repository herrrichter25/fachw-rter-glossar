<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Digitale Raumbeispiele - Interaktive Karte</title>

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body, html { height: 100%; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overflow: hidden; }

    #app-container { display: flex; height: 100vh; width: 100vw; position: relative; }
    #map { flex-grow: 1; height: 100%; z-index: 1; }

    /* Fadenkreuz-Cursor beim Platzieren */
    .picking-location { cursor: crosshair !important; }

    /* Einklappbare Seitenleiste */
    #sidebar {
      width: 380px;
      max-width: 90vw;
      height: 100%;
      background: #ffffff;
      box-shadow: 2px 0 12px rgba(0,0,0,0.15);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease;
      position: absolute;
      left: 0;
      top: 0;
    }

    #sidebar.collapsed { transform: translateX(-100%); }

    /* Sidebar-Umschaltknopf */
    #toggle-sidebar-btn {
      position: absolute;
      top: 16px;
      left: 396px;
      z-index: 1001;
      background: #0056b3;
      color: white;
      border: none;
      padding: 10px 14px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      transition: left 0.3s ease;
    }
    #sidebar.collapsed + #toggle-sidebar-btn { left: 16px; }

    /* Kopfbereich */
    .sidebar-header {
      padding: 16px 20px;
      background: #f8f9fa;
      border-bottom: 1px solid #dee2e6;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .sidebar-header h2 { font-size: 1.15rem; color: #333; }

    /* Navigation / Tabs */
    .tabs { display: flex; border-bottom: 1px solid #dee2e6; background: #fafafa; }
    .tab-btn {
      flex: 1;
      padding: 12px;
      border: none;
      background: none;
      cursor: pointer;
      font-weight: 500;
      color: #666;
      border-bottom: 2px solid transparent;
    }
    .tab-btn.active { color: #0056b3; border-bottom-color: #0056b3; background: #fff; font-weight: 600; }

    /* Hauptinhalt der Sidebar */
    .sidebar-content { padding: 18px; overflow-y: auto; flex-grow: 1; }

    /* Formularfelder */
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 600; color: #495057; margin-bottom: 5px; }
    .form-control {
      width: 100%;
      padding: 9px 12px;
      font-size: 0.9rem;
      border: 1px solid #ced4da;
      border-radius: 5px;
      background-color: #fff;
    }
    .form-control:focus { outline: none; border-color: #80bdff; box-shadow: 0 0 0 2px rgba(0,123,255,0.2); }
    textarea.form-control { resize: vertical; min-height: 70px; }

    /* Koordinaten-Box */
    .coord-box {
      display: flex;
      gap: 8px;
      margin-bottom: 8px;
    }
    .btn-pick {
      width: 100%;
      background: #e9ecef;
      color: #333;
      border: 1px dashed #6c757d;
      padding: 10px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 500;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .btn-pick.active { background: #ffeeba; border-color: #ffc107; color: #856404; }

    /* Buttons */
    .btn-primary {
      width: 100%;
      background: #0056b3;
      color: white;
      border: none;
      padding: 11px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .btn-primary:hover { background: #004085; }

    /* Punkteliste */
    .point-card {
      border: 1px solid #e9ecef;
      border-left: 4px solid #0056b3;
      border-radius: 6px;
      padding: 12px;
      margin-bottom: 10px;
      background: #fff;
      cursor: pointer;
      transition: box-shadow 0.2s;
    }
    .point-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .point-card-header { display: flex; justify-content: space-between; align-items: baseline; }
    .point-card-title { font-weight: 600; color: #212529; font-size: 0.95rem; }
    .point-card-badge { font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #e9ecef; color: #495057; }
    .point-card-desc { font-size: 0.85rem; color: #6c757d; margin-top: 5px; line-height: 1.3; }
    .point-card-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
    .btn-sm-delete { background: none; border: none; color: #dc3545; cursor: pointer; font-size: 0.8rem; }

    /* Footer mit Export */
    .sidebar-footer { padding: 12px 18px; border-top: 1px solid #dee2e6; background: #f8f9fa; }
    .btn-export {
      width: 100%;
      background: #28a745;
      color: white;
      border: none;
      padding: 9px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
    }
    .btn-export:hover { background: #218838; }
  </style>
</head>
<body>

<div id="app-container">
  <!-- Seitenleiste -->
  <aside id="sidebar">
    <div class="sidebar-header">
      <h2>Raumbeispiele</h2>
      <span id="point-counter" class="point-card-badge">0 Orte</span>
    </div>

    <!-- Modus-Umschalter -->
    <div class="tabs">
      <button class="tab-btn active" onclick="switchTab('list')">Übersicht</button>
      <button class="tab-btn" onclick="switchTab('add')">+ Neuer Ort</button>
    </div>

    <!-- TAB 1: ÜBERSICHT & FILTER -->
    <div id="tab-list" class="sidebar-content">
      <div class="form-group">
        <label for="filter-topic">Thema filtern:</label>
        <select id="filter-topic" class="form-control" onchange="renderPointsList()">
          <option value="all">Alle Themen anzeigen</option>
        </select>
      </div>

      <div id="points-container">
        <!-- Werden per JS generiert -->
      </div>
    </div>

    <!-- TAB 2: PUNKT HINZUFÜGEN -->
    <div id="tab-add" class="sidebar-content" style="display: none;">
      <button id="btn-pick-map" class="btn-pick" onclick="toggleMapPicker()">
        📍 Klick auf Karte für Koordinaten
      </button>

      <div class="coord-box">
        <input type="text" id="input-lat" class="form-control" placeholder="Breite (Lat)" />
        <input type="text" id="input-lng" class="form-control" placeholder="Länge (Lng)" />
      </div>

      <div class="form-group">
        <label for="input-title">Titel des Raumbeispiels *</label>
        <input type="text" id="input-title" class="form-control" placeholder="z. B. Ätna oder Hambacher Forst" required />
      </div>

      <div class="form-group">
        <label for="input-topic">Unterrichtsreihe / Thema *</label>
        <input type="text" id="input-topic" class="form-control" placeholder="z. B. Endogene Dynamik, Strukturwandel" />
      </div>

      <div class="form-group">
        <label for="input-class">Stufe / Klasse</label>
        <input type="text" id="input-class" class="form-control" placeholder="z. B. Klasse 8 oder EF" />
      </div>

      <div class="form-group">
        <label for="input-color">Kategorie-Farbe</label>
        <select id="input-color" class="form-control">
          <option value="#dc3545">Rot (z. B. Naturkatastrophen / Vulkanismus)</option>
          <option value="#007bff">Blau (z. B. Hydrologie / Küsten)</option>
          <option value="#28a745">Grün (z. B. Landwirtschaft / Biosphäre)</option>
          <option value="#fd7e14">Orange (z. B. Stadtgeographie / Industrie)</option>
          <option value="#6f42c1">Lila (z. B. Globalisierung / Disparitäten)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="input-desc">Fachliche Beschreibung / Fragestellung</label>
        <textarea id="input-desc" class="form-control" placeholder="Kernaspekte, Ursachen, Leitfragen für die SuS..."></textarea>
      </div>

      <button class="btn-primary" onclick="saveNewPoint()">Punkt auf Karte speichern</button>
    </div>

    <!-- Footer mit Export-Button -->
    <div class="sidebar-footer">
      <button class="btn-export" onclick="exportDataJson()">💾 Daten als JSON exportieren</button>
    </div>
  </aside>

  <!-- Button zum Ein-/Ausblenden der Sidebar -->
  <button id="toggle-sidebar-btn" onclick="toggleSidebar()">☰ Menü</button>

  <!-- Die eigentliche Karte -->
  <div id="map"></div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // 1. Basisdatenbestand
  const initialPoints = [
    {
      id: "pt-1",
      title: "Eyjafjallajökull",
      topic: "Endogene Gefährdung",
      classLevel: "Klasse 8",
      color: "#dc3545",
      desc: "Subglazialer Vulkan; Ausbruch 2010 zeigte die hohe Vulnerabilität vernetzter Verkehrs- und Wirtschaftssysteme.",
      lat: 63.63,
      lng: -19.62
    },
    {
      id: "pt-2",
      title: "Ätna",
      topic: "Endogene Gefährdung",
      classLevel: "Klasse 8",
      color: "#dc3545",
      desc: "Europas aktivster Stratovulkan; Mensch-Umwelt-Interaktion an fruchtbaren, aber gefährdeten Hängen.",
      lat: 37.75,
      lng: 15.00
    }
  ];

  // Daten aus dem lokalen Speicher laden oder Default nutzen
  let points = JSON.parse(localStorage.getItem('geo_points')) || initialPoints;

  // 2. Karte initialisieren
  const map = L.map('map', { zoomControl: false }).setView([30, 10], 3);
  L.control.zoom({ position: 'topright' }).addTo(map);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap-Mitwirkende',
    maxZoom: 18
  }).addTo(map);

  const markerLayerGroup = L.layerGroup().addTo(map);
  const markerRegistry = {}; // Speichert Referenzen zu den Leaflet-Markern für Fokus

  // Eigene farbige SVG-Marker erstellen
  function createCustomIcon(colorHex) {
    const svgPin = `
      <svg width="30" height="42" viewBox="0 0 30 42" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 0C6.71573 0 0 6.71573 0 15C0 26.25 15 42 15 42C15 42 30 26.25 30 15C30 6.71573 23.2843 0 15 0Z" fill="${colorHex}"/>
        <circle cx="15" cy="15" r="6" fill="white"/>
      </svg>
    `;
    return L.divIcon({
      html: svgPin,
      className: '',
      iconSize: [30, 42],
      iconAnchor: [15, 42],
      popupAnchor: [0, -38]
    });
  }

  // 3. Marker auf der Karte darstellen
  function renderMapMarkers() {
    markerLayerGroup.clearLayers();

    const selectedTopic = document.getElementById('filter-topic').value;

    points.forEach(pt => {
      if (selectedTopic !== 'all' && pt.topic !== selectedTopic) return;

      const marker = L.marker([pt.lat, pt.lng], {
        icon: createCustomIcon(pt.color || '#0056b3')
      }).addTo(markerLayerGroup);

      marker.bindPopup(`
        <div style="min-width: 180px;">
          <h3 style="margin:0 0 4px 0; color:#222; font-size:1.05rem;">${pt.title}</h3>
          <span style="display:inline-block; font-size:0.75rem; background:#eee; padding:2px 6px; border-radius:3px; margin-bottom:6px;">
            ${pt.topic || 'Allgemein'} • ${pt.classLevel || 'Alle Stufen'}
          </span>
          <p style="margin:0; font-size:0.85rem; color:#444; line-height:1.35;">${pt.desc}</p>
        </div>
      `);

      markerRegistry[pt.id] = marker;
    });

    document.getElementById('point-counter').innerText = `${points.length} Orte`;
  }

  // 4. Punkte-Liste in der Sidebar rendern
  function renderPointsList() {
    const container = document.getElementById('points-container');
    const selectedTopic = document.getElementById('filter-topic').value;
    container.innerHTML = '';

    // Filter-Dropdown aktualisieren
    updateTopicFilterDropdown();

    const filtered = points.filter(p => selectedTopic === 'all' || p.topic === selectedTopic);

    if (filtered.length === 0) {
      container.innerHTML = `<p style="color:#888; font-size:0.9rem; text-align:center; margin-top:20px;">Keine Raumbeispiele vorhanden.</p>`;
      renderMapMarkers();
      return;
    }

    filtered.forEach(pt => {
      const card = document.createElement('div');
      card.className = 'point-card';
      card.style.borderLeftColor = pt.color || '#0056b3';
      card.innerHTML = `
        <div class="point-card-header">
          <span class="point-card-title">${pt.title}</span>
          <span class="point-card-badge">${pt.classLevel || 'Sek I/II'}</span>
        </div>
        <div class="point-card-desc"><b>${pt.topic || ''}</b>: ${pt.desc ? pt.desc.substring(0, 75) + '...' : ''}</div>
        <div class="point-card-actions">
          <button class="btn-sm-delete" onclick="deletePoint('${pt.id}', event)">Löschen</button>
        </div>
      `;

      // Klick auf Karte fokussiert den Ort
      card.onclick = () => {
        map.flyTo([pt.lat, pt.lng], 6, { duration: 1.2 });
        if (markerRegistry[pt.id]) {
          markerRegistry[pt.id].openPopup();
        }
      };

      container.appendChild(card);
    });

    renderMapMarkers();
  }

  function updateTopicFilterDropdown() {
    const select = document.getElementById('filter-topic');
    const currentVal = select.value;
    const topics = [...new Set(points.map(p => p.topic).filter(Boolean))];

    select.innerHTML = '<option value="all">Alle Themen anzeigen</option>';
    topics.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = t;
      if (t === currentVal) opt.selected = true;
      select.appendChild(opt);
    });
  }

  // 5. Interaktiver Karten-Picker & Draggable Preview Marker
  let isPicking = false;
  let previewMarker = null;

  function toggleMapPicker() {
    isPicking = !isPicking;
    const btn = document.getElementById('btn-pick-map');
    const mapEl = document.getElementById('map');

    if (isPicking) {
      btn.classList.add('active');
      btn.innerText = '🎯 Klicke auf die gewünschte Stelle';
      mapEl.classList.add('picking-location');
    } else {
      btn.classList.remove('active');
      btn.innerText = '📍 Klick auf Karte für Koordinaten';
      mapEl.classList.remove('picking-location');
    }
  }

  map.on('click', function(e) {
    if (!isPicking) return;

    const { lat, lng } = e.latlng;
    setCoordinates(lat, lng);
    toggleMapPicker(); // Picker nach Klick deaktivieren
  });

  function setCoordinates(lat, lng) {
    document.getElementById('input-lat').value = lat.toFixed(4);
    document.getElementById('input-lng').value = lng.toFixed(4);

    if (previewMarker) map.removeLayer(previewMarker);

    // Verschiebbarer Vorschau-Pin
    previewMarker = L.marker([lat, lng], {
      draggable: true,
      icon: createCustomIcon('#ffc107')
    }).addTo(map);

    previewMarker.bindPopup("Position anpassen durch Verschieben").openPopup();

    previewMarker.on('dragend', function(ev) {
      const pos = ev.target.getLatLng();
      document.getElementById('input-lat').value = pos.lat.toFixed(4);
      document.getElementById('input-lng').value = pos.lng.toFixed(4);
    });
  }

  // Manuelle Eingabe im Formular aktualisiert den Vorschau-Marker
  ['input-lat', 'input-lng'].forEach(id => {
    document.getElementById(id).addEventListener('change', () => {
      const lat = parseFloat(document.getElementById('input-lat').value);
      const lng = parseFloat(document.getElementById('input-lng').value);
      if (!isNaN(lat) && !isNaN(lng)) {
        setCoordinates(lat, lng);
        map.panTo([lat, lng]);
      }
    });
  });

  // 6. Neuen Punkt speichern
  function saveNewPoint() {
    const title = document.getElementById('input-title').value.trim();
    const topic = document.getElementById('input-topic').value.trim();
    const classLevel = document.getElementById('input-class').value.trim();
    const color = document.getElementById('input-color').value;
    const desc = document.getElementById('input-desc').value.trim();
    const lat = parseFloat(document.getElementById('input-lat').value);
    const lng = parseFloat(document.getElementById('input-lng').value);

    if (!title) {
      alert("Bitte geben Sie mindestens einen Titel ein.");
      return;
    }
    if (isNaN(lat) || isNaN(lng)) {
      alert("Bitte wählen Sie einen Ort auf der Karte oder tragen Sie Koordinaten ein.");
      return;
    }

    const newPt = {
      id: "pt-" + Date.now(),
      title,
      topic,
      classLevel,
      color,
      desc,
      lat,
      lng
    };

    points.push(newPt);
    localStorage.setItem('geo_points', JSON.stringify(points));

    // Aufräumen & Zurück zur Liste
    if (previewMarker) {
      map.removeLayer(previewMarker);
      previewMarker = null;
    }

    // Felder leeren
    document.getElementById('input-title').value = '';
    document.getElementById('input-topic').value = '';
    document.getElementById('input-class').value = '';
    document.getElementById('input-desc').value = '';
    document.getElementById('input-lat').value = '';
    document.getElementById('input-lng').value = '';

    switchTab('list');
    map.flyTo([lat, lng], 5);
  }

  // 7. Punkt löschen
  function deletePoint(id, event) {
    event.stopPropagation();
    if (confirm("Möchten Sie dieses Raumbeispiel wirklich löschen?")) {
      points = points.filter(p => p.id !== id);
      localStorage.setItem('geo_points', JSON.stringify(points));
      renderPointsList();
    }
  }

  // 8. JSON Export / Backup
  function exportDataJson() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(points, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", "raumbeispiele_backup.json");
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  }

  // 9. UI-Steuerung (Tabs & Sidebar ein/ausklappen)
  function switchTab(tabName) {
    const tabList = document.getElementById('tab-list');
    const tabAdd = document.getElementById('tab-add');
    const btns = document.querySelectorAll('.tab-btn');

    btns.forEach(b => b.classList.remove('active'));

    if (tabName === 'list') {
      tabList.style.display = 'block';
      tabAdd.style.display = 'none';
      btns[0].classList.add('active');
      if (isPicking) toggleMapPicker();
      renderPointsList();
    } else {
      tabList.style.display = 'none';
      tabAdd.style.display = 'block';
      btns[1].classList.add('active');
    }
  }

  function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    sidebar.classList.toggle('collapsed');
  }

  // Start initialisieren
  renderPointsList();
</script>
</body>
</html>
